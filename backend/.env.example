# ---------------------------------------------------------------------------
# Nimbus Support Agent - backend configuration
# Copy to .env and fill in. Every value has a safe default except the secrets.
# ---------------------------------------------------------------------------

ENV=development                      # development | production (JSON logs, /docs disabled)
LOG_LEVEL=INFO
# JSON list of allowed browser origins (the Next.js frontend)
CORS_ORIGINS=["http://localhost:3000"]

# --- Database: Supabase Postgres with the pgvector extension -----------------
# Local:     postgresql://postgres:postgres@localhost:54329/support   (docker compose up db)
# Supabase:  Project Settings > Database > Connection string. Use the *session* pooler (port 5432)
#            or the transaction pooler (port 6543; DB_STATEMENT_CACHE_SIZE must stay 0).
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/support
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_STATEMENT_CACHE_SIZE=0
AUTO_MIGRATE=true                    # apply schema.sql on startup (idempotent)
AUTO_SEED=true                       # insert mock CRM customers/invoices if missing
AUTO_INGEST=true                     # embed policy docs on startup (skips unchanged docs by checksum)

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite
VERIFIER_MODEL=gemini-3.5-flash-lite
LIVE_MODEL=gemini-3.8-live
LIVE_VOICE=Kore
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
AGENT_THINKING_LEVEL=low             # minimal | low | medium | high | (empty = model default)
AGENT_TEMPERATURE=0.2

# Timeouts / retries
LLM_FIRST_TOKEN_TIMEOUT_S=20
LLM_TOTAL_TIMEOUT_S=60
LLM_MAX_RETRIES=2
VERIFIER_TIMEOUT_S=12
TOOL_TIMEOUT_S=8
TOOL_MAX_RETRIES=1
AGENT_MAX_STEPS=8

# --- RAG & guardrails --------------------------------------------------------
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_HIGH_CONFIDENCE=0.75             # calibrate: uv run python -m app.cli calibrate
RAG_LOW_CONFIDENCE=0.66
GROUNDEDNESS_ENABLED=true
GROUNDEDNESS_MIN_SCORE=0.7
MAX_VERIFICATION_ATTEMPTS=3

# --- Abuse protection --------------------------------------------------------
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_VOICE_PER_MIN=6
MAX_CONCURRENT_VOICE_PER_IP=2
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_SESSION=200
VOICE_MAX_SESSION_S=600

# --- Demo ------------------------------------------------------------------
ENABLE_CHAOS=true                    # allow fault injection from the UI (tool failures, LLM 429/timeouts)
DEMO_MODE=true                       # expose demo customer credentials + /api/demo/reset

# Optional: override cost estimates, JSON {"model": {"input": 0.75, "output": 3.75}}
# PRICING_OVERRIDES=
